# ==============================================================================
# Model Configuration (.env is the single source of truth for all models)
# ==============================================================================

# Option 1: Google Gemini (Multimodal Realtime Voice & Text)
# - Realtime Live Voice: google:gemini-3.8-live
# - Text Advisor:        google:gemini-3.8-flash  (or google:gemini-3.1-flash-lite)
GEMINI_API_KEY=your_gemini_api_key_here
REALTIME_MODEL=google:gemini-3.8-live
TEXT_MODEL=google:gemini-3.8-flash

# Option 2: OpenAI (Multimodal Realtime Voice & Text)
# OPENAI_API_KEY=sk-proj-...
# REALTIME_MODEL=openai:gpt-4o-mini-realtime-preview
# TEXT_MODEL=openai:gpt-4o-mini

# ==============================================================================
# Deepgram Configuration (for --nomodal voice: Deepgram STT -> Text LLM -> Deepgram TTS)
# ==============================================================================
# DEEPGRAM_API_KEY=your_deepgram_api_key_here
# DEEPGRAM_STT_MODEL=nova-2
# DEEPGRAM_TTS_MODEL=aura-asteria-en
# DEEPGRAM_ENDPOINTING_MS=400

# ==============================================================================
# Backend API & Authentication
# ==============================================================================
API_BASE_URL=http://127.0.0.1:8000
# Optional: pre-populate access token to avoid typing it each run
# LEDGERAI_ACCESS_TOKEN=your_jwt_access_token
